# ── Web UI ──────────────────────────────────────
APP_PORT=3000
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET

# ── TeamSpeak 3 Server ───────────────────────────
TS3_SERVER=your.ts3server.com
TS3_PORT=9987
TS3_PASSWORD=
TS3_NICKNAME=MusicBot
# Channel name to auto-join (leave empty for default)
TS3_CHANNEL=Music
